+          }
+          for series in \
+            airouter_endpoint_attempts_total \
+            airouter_endpoint_attempt_failures_total \
+            airouter_endpoint_attempt_duration_seconds; do
+            if ! grep -q "^$series" /tmp/metrics.txt; then
+              echo "::error::missing metric series: $series"
+              exit 1
+            fi
+          done
