+            echo "the upstream emitted keepalives on every request, so a zero here means the counter is not wired"
+            exit 1
+          fi
+          echo "sse comments routed out: $comments"
+
+      - name: stop servers
+        if: always()
+        run: |
+          for f in /tmp/airouter.pid /tmp/fake-upstream.pid; do
+            [ -f "$f" ] || continue
+            kill "$(cat "$f")" 2>/dev/null || true
+          done
+
+      - name: gateway log
+        if: always()
+        run: |
+          echo "--- fake upstream ---"; cat /tmp/fake-upstream.log 2>/dev/null || true
+          echo "--- gateway ---"; cat /tmp/airouter.log 2>/dev/null || true
