+            printf '%s\n' "$body" | head -20
+            exit 1
+          fi
+
+      - name: metrics expose attempt telemetry
+        run: |
+          # /metrics is authenticated: the series are labelled by provider and
+          # model, so an unauthenticated scrape is an information leak. Assert
+          # the rejection too, so a future refactor can't quietly unprotect it.
+          code=$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:9090/metrics)
+          if [ "$code" = "200" ]; then
+            echo "::error::/metrics served without credentials"
+            exit 1
+          fi
+          # Drive one request first: the attempt series only exist once the
+          # router has actually made an attempt, so scraping a freshly booted
+          # gateway would otherwise assert against an empty registry.
+          curl -sf -o /dev/null -H 'Content-Type: application/json' \
+            -H 'Authorization: Bearer ci-test-key' \
+            -d '{"model":"work","stream":false,"messages":[{"role":"user","content":"ping"}]}' \
+            http://127.0.0.1:9090/v1/chat/completions || true
+          curl -sf -H 'Authorization: Bearer ci-test-key' \
+            -o /tmp/metrics.txt http://127.0.0.1:9090/metrics || {
