           PY
 
+      - name: no series uses the overflow bucket as a label set
+        run: |
+          # The regex above is deliberately lenient about label sets -- it
+          # accepts any {...} -- so it would happily pass a line like
+          #   airouter_circuit_state_transitions{__overflow__} 4
+          # which is NOT a legal sample: circuitTransitions keys on a
