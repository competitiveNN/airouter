+          # successful probe means the socket is accepting, not just bound.
+          for i in $(seq 1 50); do
+            if curl -sf -o /dev/null -X POST http://127.0.0.1:9099/v1/chat/completions; then
+              echo "fake upstream ready after ${i} probe(s)"
+              exit 0
+            fi
