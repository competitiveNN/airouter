+          if ! grep -q '^airouter_metrics_label_evictions_total' /tmp/metrics3.txt; then
+            echo "::error::airouter_metrics_label_evictions_total is not exported"
+            exit 1
+          fi
+          echo "label set shape and eviction counter OK"
+
       - name: stop servers
         if: always()
         run: |
