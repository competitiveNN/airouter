+      # started with setsid + a PID file and torn down in `stop servers`, which
+      # is `if: always()` so a failed assertion still releases the ports for
+      # the job's own cleanup and the log step can still read the log file.
+      #
+      # The config is a committed fixture (testdata/ci-config.yaml), not a
+      # heredoc: a config that only exists inside a `run:` block is invisible to
+      # review, to the `config` job, and to anyone debugging a failure.
+      - name: start fake upstream
+        run: |
+          setsid python3 scripts/fake-sse-upstream.py --port 9099 \
+            > /tmp/fake-upstream.log 2>&1 < /dev/null &
+          echo $! > /tmp/fake-upstream.pid
