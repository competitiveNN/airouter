 model_utils.py                      | 22 ++++++--
 scripts/export-envrc.sh             | 88 +++++++++++++++++++++++++++++
 scripts/run-airouter.sh             | 43 ++++++++++++++
 systemd/airouter-model-sync.service |  8 ++-
 systemd/airouter.service            |  8 ++-
 6 files changed, 164 insertions(+), 7 deletions(-)
 create mode 100755 scripts/export-envrc.sh
 create mode 100755 scripts/run-airouter.sh

