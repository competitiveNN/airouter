+            echo "::error::no upstream attempts recorded; attempt telemetry is dead"
+            exit 1
+          fi
+
+      - name: assert SSE comment counter is wired and non-zero
+        run: |
+          # The fake upstream interleaves ": keepalive" lines on every request,
+          # and the contract step above already made 12 of them. If the counter
