[Unit]
Description=Airouter model sync (refresh the free-model list, permanently blacklist models gone upstream, rebuild config.yaml, commit and push the caches)
Documentation=file:%h/dev/airouter/scripts/sync-instruction.txt
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/dev/airouter
# The sync script refreshes model metadata from the upstream provider APIs,
# so it needs the same credentials as the daemon. Load them the same way the
# daemon does: source the .envrc next to the binary. systemd's EnvironmentFile=
# cannot be used here (it is not a shell parser, so it ignores `export KEY=value`
# and resolves no intra-file references).
ExecStart=/bin/bash -c 'set -a; . %h/dev/airouter/.envrc; set +a; exec %h/dev/airouter/scripts/sync-models.sh'
TimeoutStartSec=30min
# This is a scheduled refresh of a file the daemon hot-reloads, not the
# request path. The fetcher issues a few dozen API calls (six provider
# listings, the opencode gate probes, two terminator probes) and rewrites
# cooldowns-independent caches, so run it strictly below the daemon.
Nice=10
IOSchedulingClass=idle
# The sync reads cooldowns.db while the daemon is writing it. That is safe by
# construction, not by luck: SQLite in WAL mode gives a reader a committed
# snapshot, never a half-written row — which is why scripts/sync-models.sh can
# treat an unreadable store as "no evidence" instead of failing the sync.
SyslogIdentifier=airouter-model-sync