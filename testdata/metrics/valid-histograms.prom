# Golden fixture: output the histogram guard MUST accept.
# Captured from a running gateway under load with 17 label evictions,
# so it includes real histograms plus the __overflow__ gauges. Generated
# rather than hand-written so it cannot be 'fixed' into looking valid.
# HELP airouter_requests_total Total requests by model and status
# TYPE airouter_requests_total counter
# HELP airouter_failures_total Total failures by status code
# TYPE airouter_failures_total counter
# HELP airouter_fallbacks_total Number of model fallbacks
# TYPE airouter_fallbacks_total counter
# HELP airouter_fallbacks_total_by_endpoint Number of fallbacks triggered by each endpoint
# TYPE airouter_fallbacks_total_by_endpoint counter
# HELP airouter_cooldowns_applied_total Number of cooldown applications
# TYPE airouter_cooldowns_applied_total counter
# HELP airouter_circuit_state_transitions Number of circuit breaker state transitions
# TYPE airouter_circuit_state_transitions counter
# HELP airouter_request_duration_seconds Request latency in seconds
# TYPE airouter_request_duration_seconds histogram
# HELP airouter_sse_comments_routed_out SSE comment lines dropped instead of being parsed as events
# TYPE airouter_sse_comments_routed_out counter
# HELP airouter_metrics_label_overflow_total Observations folded into the overflow bucket because the label registry is full
# TYPE airouter_metrics_label_overflow_total counter
# HELP airouter_metrics_label_evictions_total Labels displaced from the registry to admit a newer one
# TYPE airouter_metrics_label_evictions_total counter
# HELP airouter_endpoint_attempts_total Upstream attempts made against each endpoint
# TYPE airouter_endpoint_attempts_total counter
# HELP airouter_endpoint_attempt_failures_total Upstream attempts against each endpoint that failed
# TYPE airouter_endpoint_attempt_failures_total counter
# HELP airouter_endpoint_attempt_duration_seconds Duration of a single upstream attempt
# TYPE airouter_endpoint_attempt_duration_seconds histogram
# HELP airouter_evicted_attempts_latency_seconds_sum Latency of attempts whose endpoint was evicted from the metrics window. NOT a histogram: the per-latency-band distribution is unknown and is not reported, so do not use histogram_quantile on this.
# TYPE airouter_evicted_attempts_latency_seconds_sum gauge
# HELP airouter_evicted_attempts_latency_seconds_count Number of attempts whose endpoint was evicted from the metrics window. NOT a histogram: see the _sum metric.
# TYPE airouter_evicted_attempts_latency_seconds_count gauge

