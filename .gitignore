# Secrets / env
.envrc
.env

# Build artifacts
airouter
NOTES.txt
__pycache__/
*.bak

# The live config is regenerated by the nightly model sync
# (scripts/sync-models.sh) and must NOT be committed: it carries API keys
# and provider-specific model choices. New operators copy config.example.yaml
# to config.yaml and fill in their own keys.
config.yaml

# Regenerable caches.  first-seen-cache.json is NOT here: it only
# changes when a model appears or a month passes without a listing,
# and it is committed so the first-seen dates survive a fresh clone.
free-models-cache.json
arena-code-cache.json
aa-enrichment-cache.json
opencode-probe-cache.json

# Runtime state (regenerated on startup)
cooldowns.json
cooldowns.priority.json
# The dashboard stats journal is append-only runtime state:
# it grows every minute the gateway serves traffic, so it
# must stay out of the tree fingerprint (and out of git).
metrics-ring.jsonl

# Tooling metadata
.maki/

# Generated by scripts/export-unpushed.sh — build artifacts, not source.
# Committing them is self-referential: the commit would change the very set
# the bundle contains, so it could never converge. See dist/README.md.
/dist/*.bundle
/dist/*.patch

# Go fuzzing corpus cache. Only the minimized crashers under testdata/fuzz are
# worth committing; the working corpus is gigabytes of generated input.
/fuzzcache/

# Editor scratch files. Not cosmetic: scripts/gate.sh fingerprints the worktree
# with `git status --porcelain -uall` at the start of a run and compares it at
# the end, and -uall is exactly what makes untracked paths count. A vim swap file
# sitting in the repo root therefore participates in the fingerprint, so an
# editor opening a tracked file DURING a gate run flips that run to INVALID RUN
# (exit 3) -- void results, for a file nobody wrote on purpose. Ignored, it
# leaves the fingerprint alone.
*.swp
*.swo

# Regenerator backups. `.gitignore` already covers *.bak, but
# regenerate_config.py also writes config.yaml.bak2 on a second run in the same
# session, and that one was NOT ignored: it showed up in `git status`, so it
# participated in the gate's tree fingerprint and could turn a run INVALID for
# a file nobody made by hand.
*.bak2

# ---- Audit artifacts: ephemeral, never committed ----
# Standing rule: no audit file is ever committed. Audit output is work product --
# read it, act on the finding, discard it. A committed audit is a snapshot of a
# state that no longer exists, and a merged one is a claim nobody re-verifies.
#
# The patterns below match ARTIFACTS only. The code that PERFORMS audits --
# scripts/audit-*.py and scripts/audit-*.sh -- is permanent, tested and gated,
# and is deliberately NOT matched: it reads and asserts, which is exactly what
# belongs in git. (An artifact is a report or note ABOUT the code; a checker is
# code that reads the code. Only the first is ephemeral.)
#
# Note the extension split is load-bearing: these match .md/.txt/.json, so no
# pattern here can ever swallow a checker.
docs/notebook/
audit-*.md
audit-*.txt
audit-*.json
audit-notes*.md
*-audit.md
*_audit.md
*_findings.md
*_audit_report.*
